# Copiá este archivo a .env y ajustá los valores según tu entorno.
# NO commitees el archivo .env real (está en .gitignore).

# API key de la API.
# - Si la definís aquí, tiene prioridad sobre data/apikey.txt.
# - Si la dejás vacía/omitida, la app genera una automáticamente
#   (secrets.token_urlsafe(32)) y la guarda en data/apikey.txt.
# Generá una manualmente con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RAR_API_KEY=
