[Unit]
Description=RAR Descompresor API (FastAPI)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/rar-descompresor-api
ExecStart=/home/ubuntu/rar-descompresor-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8072
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
